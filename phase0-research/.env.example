# Phase 0 Research — Environment Variables

Copy this file to `.env` and fill in the values.

# Coston2 RPC (public endpoint, no key needed)
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Wallet (generated by scripts/create-wallet.ts, stored in .secrets.json)
# Do NOT put your private key in this file — use .secrets.json instead.

# Optional: Verifier API key (not needed for testnet — use 00000000-0000-0000-0000-000000000000)
# VERIFIER_API_KEY=

# Optional: DA Layer URL (defaults to public Coston2 endpoint)
# DA_LAYER_URL=https://ctn2-data-availability.flare.network
