# FlarePay platform mode — Supabase (current key system, 2026).
# Without these the server runs in single-tenant LOCAL mode.

# Project Settings → Data API → Project URL  (NEXT_PUBLIC_SUPABASE_URL also accepted)
SUPABASE_URL=

# Project Settings → API Keys → "Secret keys" → create/reveal (sb_secret_…)
# This is the SERVER key — it bypasses RLS and drives auth.admin. Never ship to a browser.
# (Legacy service_role JWT also accepted via SUPABASE_SERVICE_ROLE_KEY until sunset.)
SUPABASE_SECRET_KEY=

# Connect (top bar) → Connection string → URI ("direct" works) — used only by `pnpm migrate`
SUPABASE_DB_URL=

# Optional demo account overrides
DEMO_EMAIL=demo@flarepay.dev
DEMO_PASSWORD=flarepay-demo-2026
