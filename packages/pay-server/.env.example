# FlarePay platform mode — create a free project at https://database.new then
# copy these from Project Settings → API. Without them the server runs in
# single-tenant LOCAL mode (JSON store, one API key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Settings → Database) — used only by `pnpm migrate`
SUPABASE_DB_URL=
# Optional demo account overrides
DEMO_EMAIL=demo@flarepay.dev
DEMO_PASSWORD=flarepay-demo-2026
