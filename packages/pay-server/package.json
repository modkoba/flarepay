{
  "name": "@flarekit/pay-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlarePay charge server: FTSO-priced charges, XRPL watcher, FDC settlement, x402 endpoints.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
