    "test": "echo 'pay-server: verified by live settlement (integration)'",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@flarekit/sdk": "workspace:*",
    "@supabase/supabase-js": "^2.112.2",
    "ethers": "^6.13.0",
    "xrpl": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "pg": "^8.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
